# Copy to .env (git-ignored) and fill in. Used only by `ua-mbrl remote ...`.

# https://cloud.vast.ai/manage-keys/  (API key)
VAST_API_KEY=

# Private key used to SSH into instances; <path>.pub must exist next to it.
# It is attached to each instance automatically.
VAST_SSH_KEY=~/.ssh/id_ed25519

# Only for --source github (the default when HEAD is pushed and the tree is
# clean): a fine-grained token with read-only "Contents" access to the repo.
GITHUB_TOKEN=
GITHUB_REPO=owner/ua-mbrl

# Optional: container image (needs a driver with CUDA >= 12.8 on the host;
# the project's own torch comes from uv, not the image).
# VAST_IMAGE=pytorch/pytorch:2.7.1-cuda12.8-cudnn9-runtime
